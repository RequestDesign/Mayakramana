{
  "name": "role-consultant",
  "version": 1,
  "description": "Консультант реабилитационного центра. Другая позиция, чем врач: другой путь в профессию, другое прошлое, другие компетенции. Общее с врачом — человек и внешность — наследуется, а не дублируется.",
  "extends": ["human-core.json", "human-visual.json"],
  "params": [
    {
      "key": "recovery_background",
      "title": "Личный опыт зависимости",
      "group": "путь",
      "identity": true,
      "note": "Ключевой параметр роли: от него зависит почти всё остальное. Консультант из сообщества и консультант с образованием — два разных человека.",
      "domain": {
        "kind": "enum",
        "variants": [
          {"value": "выздоравливающий, прошёл программу", "weight": 62},
          {"value": "созависимый, прошёл программу для родственников", "weight": 18},
          {"value": "без личного опыта, пришёл через образование", "weight": 20}
        ]
      }
    },
    {
      "key": "clean_years",
      "title": "Лет в трезвости",
      "group": "путь",
      "identity": true,
      "note": "Ноль означает, что личного опыта употребления не было. Жёсткое правило не даёт стажу работы превысить срок трезвости.",
      "domain": {
        "kind": "int", "min": 0, "max": 30,
        "weights": [40, 1, 2, 4, 6, 8, 9, 9, 8, 7, 6, 5, 5, 4, 4, 3, 3, 2, 2, 2, 2, 1.5, 1.5, 1, 1, 1, 0.8, 0.8, 0.6, 0.6, 0.5]
      }
    },
    {
      "key": "substance",
      "title": "С чем был связан опыт",
      "group": "путь",
      "mention": "background",
      "directive": "какой опыт за плечами (говорить о нём сдержанно, без подробностей употребления)",
      "domain": {
        "kind": "enum",
        "variants": [
          {"value": "алкоголь", "weight": 40},
          {"value": "опиаты", "weight": 22},
          {"value": "стимуляторы", "weight": 16},
          {"value": "смешанное употребление", "weight": 14},
          {"value": "игровая зависимость", "weight": 8}
        ]
      }
    },
    {
      "key": "path_to_work",
      "title": "Как пришёл в профессию",
      "group": "путь",
      "identity": true,
      "domain": {
        "kind": "enum",
        "variants": [
          {"value": "через сообщество, остался помогать", "weight": 38},
          {"value": "вернулся в центр, где проходил программу", "weight": 24},
          {"value": "пришёл после обучения на консультанта", "weight": 22},
          {"value": "начинал волонтёром", "weight": 16}
        ]
      }
    },
    {
      "key": "training",
      "title": "Подготовка",
      "group": "подготовка",
      "mention": "background",
      "directive": "какая подготовка за плечами (опирайся на это, но не пересказывай строкой)",
      "domain": {
        "kind": "enum",
        "variants": [
          {"value": "сертификация консультанта по зависимостям", "weight": 44},
          {"value": "профильное психологическое образование", "weight": 20},
          {"value": "обучение внутри центра и наставничество", "weight": 26},
          {"value": "педагогическое или социальное образование", "weight": 10}
        ]
      }
    },
    {
      "key": "experience_years",
      "title": "Стаж консультантом",
      "group": "опыт",
      "identity": true,
      "domain": {
        "kind": "int", "min": 1, "max": 25,
        "weights": [8, 10, 11, 11, 10, 9, 8, 7, 6, 5, 4, 3.5, 3, 2.5, 2, 1.8, 1.5, 1.2, 1, 0.9, 0.8, 0.7, 0.6, 0.5, 0.4]
      }
    },
    {
      "key": "group_work",
      "title": "Ведёт группы",
      "group": "опыт",
      "domain": {"kind": "bool", "p_true": 0.78}
    },
    {
      "key": "sponsor_experience",
      "title": "Опыт наставничества",
      "group": "опыт",
      "domain": {"kind": "bool", "p_true": 0.6}
    },
    {
      "key": "crisis_work",
      "title": "Работа с острыми состояниями",
      "group": "опыт",
      "mention": "background",
      "directive": "работает ли с острыми состояниями (если нет — просто не упоминать)",
      "domain": {"kind": "bool", "p_true": 0.45}
    },
    {
      "key": "family_work",
      "title": "Работа с родственниками",
      "group": "опыт",
      "domain": {"kind": "bool", "p_true": 0.55}
    },
    {
      "key": "focus",
      "title": "С кем работает",
      "group": "опыт",
      "mention": "background",
      "directive": "о каких подопечных писать (показать через описание работы, не называть категорией)",
      "domain": {
        "kind": "multi_enum",
        "min_pick": 1,
        "max_pick": 3,
        "variants": [
          {"value": "новички в программе", "weight": 30},
          {"value": "срывающиеся", "weight": 22},
          {"value": "молодые", "weight": 16},
          {"value": "возрастные", "weight": 14},
          {"value": "созависимые родственники", "weight": 18}
        ]
      }
    },
    {
      "key": "approach",
      "title": "Что считает главным",
      "group": "опыт",
      "domain": {
        "kind": "enum",
        "variants": [
          {"value": "честность с самим собой", "weight": 24},
          {"value": "режим и структура дня", "weight": 20},
          {"value": "принадлежность к группе", "weight": 22},
          {"value": "работа с отрицанием", "weight": 20},
          {"value": "возвращение ответственности", "weight": 14}
        ]
      }
    },
    {
      "key": "full_name",
      "title": "ФИО",
      "group": "базовые",
      "identity": true,
      "mention": "required",
      "note": "Из справочника имён, как и у врача.",
      "domain": {"kind": "derived"}
    },
    {"key": "biography", "title": "Биография", "group": "текст", "domain": {"kind": "derived"}},
    {"key": "professional_path", "title": "Профессиональный путь", "group": "текст", "domain": {"kind": "derived"}},
    {"key": "quote", "title": "Цитата", "group": "текст", "domain": {"kind": "derived"}}
  ],
  "hard": [
    {
      "name": "трезвость_не_дольше_взрослой_жизни",
      "expr": "clean_years <= age - 18",
      "message": "срок трезвости превышает возможный при данном возрасте"
    },
    {
      "name": "стаж_не_дольше_трезвости",
      "expr": "recovery_background != 'выздоравливающий, прошёл программу' or experience_years <= clean_years",
      "message": "консультант не может работать дольше, чем находится в трезвости"
    },
    {
      "name": "трезвость_только_у_выздоравливающих",
      "expr": "recovery_background == 'выздоравливающий, прошёл программу' or clean_years == 0",
      "message": "срок трезвости указан у человека без опыта зависимости"
    },
    {
      "name": "стаж_не_больше_возможного",
      "expr": "experience_years <= age - 20",
      "message": "стаж превышает возможный при данном возрасте"
    },
    {
      "name": "путь_через_сообщество_требует_личного_опыта",
      "expr": "recovery_background != 'без личного опыта, пришёл через образование' or not in(path_to_work, 'через сообщество, остался помогать', 'вернулся в центр, где проходил программу')",
      "message": "прийти через сообщество или вернуться в центр, где проходил программу, можно только имея личный опыт"
    },
    {
      "name": "наставничество_требует_опыта",
      "expr": "not sponsor_experience or experience_years >= 3",
      "message": "наставничество при стаже меньше трёх лет"
    }
  ],
  "soft": [
    {
      "name": "без_личного_опыта_нет_трезвости",
      "when": "recovery_background != 'выздоравливающий, прошёл программу'",
      "then": [{"kind": "range", "param": "clean_years", "max": 0.0}]
    },
    {
      "name": "у_выздоравливающих_трезвость_есть",
      "when": "recovery_background == 'выздоравливающий, прошёл программу'",
      "then": [{"kind": "range", "param": "clean_years", "min": 4.0}]
    },
    {
      "name": "с_возрастом_дольше_трезвость",
      "when": "age >= 45",
      "then": [{"kind": "range", "param": "clean_years", "min": 8.0}]
    },
    {
      "name": "стаж_растёт_с_возрастом",
      "when": "age >= 45",
      "then": [{"kind": "range", "param": "experience_years", "min": 5.0}]
    },
    {
      "name": "у_молодых_стаж_небольшой",
      "when": "age <= 34",
      "then": [{"kind": "range", "param": "experience_years", "max": 8.0}]
    },
    {
      "name": "созависимые_работают_с_семьями",
      "when": "recovery_background == 'созависимый, прошёл программу для родственников'",
      "then": [
        {"kind": "weight", "param": "focus", "value": "созависимые родственники", "factor": 5.0},
        {"kind": "weight", "param": "family_work", "value": "true", "factor": 4.0}
      ]
    },
    {
      "name": "образованные_реже_ведут_группы_сообщества",
      "when": "recovery_background == 'без личного опыта, пришёл через образование'",
      "then": [
        {"kind": "weight", "param": "training", "value": "профильное психологическое образование", "factor": 6.0},
        {"kind": "weight", "param": "path_to_work", "value": "пришёл после обучения на консультанта", "factor": 5.0},
        {"kind": "weight", "param": "path_to_work", "value": "через сообщество, остался помогать", "factor": 0.1}
      ]
    },
    {
      "name": "опытные_наставничают",
      "when": "experience_years >= 8",
      "then": [{"kind": "weight", "param": "sponsor_experience", "value": "true", "factor": 3.0}]
    }
  ]
}
