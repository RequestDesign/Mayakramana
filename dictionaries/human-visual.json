    },
    {
      "name": "снято_на_телефон",
      "when": "photo_quality == 'снято на телефон, слегка неровный кадр'",
      "then": [
        {"kind": "weight", "param": "camera", "value": "корпоративная съёмка, одна вспышка, нейтральный фон", "factor": 0.0}
      ]
    },
    {
      "name": "в_разговоре_взгляд_мимо",
      "when": "moment == 'в разговоре с кем-то за кадром'",
      "then": [
