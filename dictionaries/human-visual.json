  "hard": [
    {
      "name": "седина_не_в_молодости",
      "expr": "hair_color != 'седой' or age >= 48",
      "message": "полностью седые волосы в этой популяции не раньше 48 лет"
    }
  ],
  "soft": [
    {
      "name": "у_женщин_нет_бороды",
      "when": "gender == 'женский'",
      "then": [
        {"kind": "force", "param": "facial_hair", "value": "нет"}
      ]
    },
    {
      "name": "с_возрастом_седеют",
      "when": "age >= 52",
      "then": [
        {"kind": "weight", "param": "hair_color", "value": "с проседью", "factor": 3.0},
        {"kind": "weight", "param": "hair_color", "value": "седой", "factor": 4.0},
        {"kind": "weight", "param": "hair_color", "value": "чёрный", "factor": 0.3}
      ]
    },
    {
      "name": "у_молодых_волосы_на_месте",
      "when": "age <= 38",
      "then": [
        {"kind": "weight", "param": "hair_state", "value": "заметные залысины", "factor": 0.15},
        {"kind": "weight", "param": "hair_state", "value": "редеющие на макушке", "factor": 0.3}
      ]
    },
    {
      "name": "у_женщин_реже_залысины",
      "when": "gender == 'женский'",
      "then": [
        {"kind": "weight", "param": "hair_state", "value": "заметные залысины", "factor": 0.05},
        {"kind": "weight", "param": "hair_state", "value": "редеющие на макушке", "factor": 0.1},
        {"kind": "weight", "param": "hair_state", "value": "короткая стрижка, отросшая", "factor": 0.4}
      ]
    },
    {
      "name": "возрастные_следы",
      "when": "age >= 50",
      "then": [
        {"kind": "weight", "param": "skin_marks", "value": "мимические морщины у глаз", "factor": 2.5},
        {"kind": "weight", "param": "skin_marks", "value": "носогубные складки", "factor": 2.5},
        {"kind": "weight", "param": "skin_marks", "value": "веснушки", "factor": 0.3}
      ]
    },
    {
      "name": "с_возрастом_хуже_спят",
      "when": "age >= 50",
      "then": [
        {"kind": "weight", "param": "eye_bags", "value": "заметные", "factor": 2.0},
        {"kind": "weight", "param": "eye_bags", "value": "нет", "factor": 0.4}
      ]
    },
    {
      "name": "зрение_с_возрастом",
      "when": "age >= 45",
      "then": [
        {"kind": "weight", "param": "glasses", "value": "нет", "factor": 0.5},
        {"kind": "weight", "param": "glasses", "value": "очки для чтения на шнурке", "factor": 2.5}
      ]
    }
