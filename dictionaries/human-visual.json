        "kind": "enum",
        "variants": [
          {"value": "лёгкая улыбка одними глазами", "weight": 12},
          {"value": "приветливое, открытое", "weight": 9},
          {"value": "сдержанная полуулыбка", "weight": 10},
          {"value": "спокойное, нейтральное, без улыбки", "weight": 16},
          {"value": "внимательный, чуть усталый взгляд", "weight": 12},
          {"value": "немного уставшее лицо, без улыбки", "weight": 14},
          {"value": "сосредоточен на своём, не улыбается", "weight": 9},
          {"value": "неловкая натянутая улыбка: не любит фотографироваться", "weight": 8},
          {"value": "доброжелательное, но без улыбки", "weight": 10}
