      ]
    },
    {
      "name": "в_позе_взгляд_в_камеру",
      "when": "moment == 'позирует, но без напряжения'",
      "then": [
        {"kind": "weight", "param": "gaze", "value": "в камеру", "factor": 3.0}
      ]
    },
    {
      "name": "профиль_не_по_центру",
      "when": "head_angle == 'вполоборота, профиль виден наполовину'",
      "then": [
