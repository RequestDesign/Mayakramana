    {"name": "стаж_после_вуза_и_ординатуры", "expr": "experience_years <= age - graduation_age - 2", "message": "стаж не помещается между окончанием вуза с ординатурой и нынешним возрастом"},
    {"name": "перерыв_в_карьере_не_больше_пяти_лет", "expr": "experience_years >= age - graduation_age - 7", "message": "необъяснимая дыра в карьере: окончил вуз давно, а стаж короткий"},
    {"name": "ординаторы_в_государственной_или_науке", "expr": "not teaches_residents or academic_activity or current_place == 'государственный наркологический диспансер'", "message": "ведёт ординаторов в частном центре без научной работы"},
    {"name": "докторская_не_рано", "expr": "education_level != 'доктор медицинских наук' or age >= 45", "message": "докторская степень раньше 45 лет"},
    {"name": "кандидатская_не_рано", "expr": "education_level != 'кандидат медицинских наук' or age >= 32", "message": "кандидатская степень раньше 32 лет"},
    {"name": "психиатрические_специальности_требуют_психиатрической_ординатуры", "expr": "not in(specialty, 'психиатр', 'психиатр-нарколог', 'психотерапевт') or in(residency, 'психиатрия-наркология', 'психиатрия')", "message": "психиатрическая специальность без психиатрической ординатуры"},
    {"name": "реаниматолог_из_анестезиологии", "expr": "specialty != 'нарколог-реаниматолог' or residency == 'анестезиология-реаниматология'", "message": "нарколог-реаниматолог без ординатуры по анестезиологии"},
    {"name": "невролог_из_неврологии", "expr": "specialty != 'невролог с наркологической практикой' or residency == 'неврология'", "message": "невролог без неврологической ординатуры"},
    {"name": "реаниматолог_с_детоксом", "expr": "specialty != 'нарколог-реаниматолог' or detox_experience", "message": "нарколог-реаниматолог без опыта детоксикации"},
    {"name": "двойной_диагноз_требует_психиатрии", "expr": "not has(practice, 'двойной диагноз') or psychiatry_experience", "message": "двойной диагноз без психиатрического опыта"},
    {"name": "подростки_не_при_пожилых", "expr": "not has(practice, 'подростковая зависимость') or patient_age_focus != 'пациенты старшего возраста'", "message": "подростковая практика при фокусе на пожилых"},
    {"name": "публикации_только_у_научных", "expr": "publications == 0 or academic_activity", "message": "публикации без научной работы"},
    {"name": "научные_интересы_только_у_научных", "expr": "research_area == 'нет' or academic_activity", "message": "научные интересы без научной работы"},
    {"name": "у_научных_есть_интересы", "expr": "not academic_activity or research_area != 'нет'", "message": "научная работа без области интересов"},
    {"name": "заведующий_со_стажем", "expr": "current_position != 'заведующий отделением' or experience_years >= 10", "message": "заведующий отделением со стажем меньше 10 лет"},
    {"name": "главврач_со_стажем", "expr": "current_position != 'главный врач' or experience_years >= 15", "message": "главный врач со стажем меньше 15 лет"},
    {"name": "главврач_не_в_частной_практике", "expr": "current_position != 'главный врач' or current_place != 'частная практика'", "message": "главный врач частной практики"},
    {"name": "ординаторов_ведут_опытные", "expr": "not teaches_residents or experience_years >= 10", "message": "ведёт ординаторов при стаже меньше 10 лет"},
    {"name": "частная_практика_после_опыта", "expr": "current_place != 'частная практика' or experience_years >= 8", "message": "частная практика при стаже меньше 8 лет"},
    {"name": "высшая_категория_от_7_лет", "expr": "qualification_category != 'высшая' or experience_years >= 7", "message": "высшая категория при стаже меньше 7 лет"},
    {"name": "первая_категория_от_5_лет", "expr": "qualification_category != 'первая' or experience_years >= 5", "message": "первая категория при стаже меньше 5 лет"},
    {"name": "вторая_категория_от_3_лет", "expr": "qualification_category != 'вторая' or experience_years >= 3", "message": "вторая категория при стаже меньше 3 лет"},
    {"name": "скорая_в_биографии", "expr": "why_addiction != 'увидел масштаб проблемы, работая на скорой' or career_1_type == 'скорая помощь'", "message": "пришёл в наркологию со скорой, но на скорой не работал"},
    {"name": "распределение_только_в_советское_время", "expr": "why_addiction != 'распределение после вуза' or graduation_year <= 1994", "message": "распределение после вуза в годы, когда его уже не было"},
    {"name": "второе_место_с_годами", "expr": "(career_2_type == 'нет') == (career_2_years == 0)", "message": "у второго места работы не сходятся наличие и годы"},
    {"name": "третье_место_с_годами", "expr": "(career_3_type == 'нет') == (career_3_years == 0)", "message": "у третьего места работы не сходятся наличие и годы"},
    {"name": "третье_только_после_второго", "expr": "career_3_type == 'нет' or career_2_type != 'нет'", "message": "третье место работы без второго"}
  ],
  "soft": [
    {"name": "ординатура_к_специальности_психиатрия", "when": "in(residency, 'психиатрия-наркология', 'психиатрия')", "then": [
      {"kind": "weight", "param": "specialty", "value": "нарколог-реаниматолог", "factor": 0.0},
      {"kind": "weight", "param": "specialty", "value": "невролог с наркологической практикой", "factor": 0.0}
    ]},
    {"name": "ординатура_наркология_к_наркологу", "when": "residency == 'психиатрия-наркология'", "then": [
      {"kind": "weight", "param": "specialty", "value": "психиатр-нарколог", "factor": 3.0}
    ]},
    {"name": "ординатура_анестезиология", "when": "residency == 'анестезиология-реаниматология'", "then": [
      {"kind": "force", "param": "specialty", "value": "нарколог-реаниматолог"}
    ]},
    {"name": "ординатура_неврология", "when": "residency == 'неврология'", "then": [
      {"kind": "force", "param": "specialty", "value": "невролог с наркологической практикой"}
    ]},
    {"name": "реаниматологи_со_скорой", "when": "residency == 'анестезиология-реаниматология'", "then": [
      {"kind": "weight", "param": "career_1_type", "value": "скорая помощь", "factor": 4.0}
    ]},

    {"name": "нет_второго_места_нет_лет", "when": "career_2_type == 'нет'", "then": [{"kind": "range", "param": "career_2_years", "max": 0.0}]},
    {"name": "есть_второе_место_есть_годы", "when": "career_2_type != 'нет'", "then": [{"kind": "range", "param": "career_2_years", "min": 1.0}]},
    {"name": "нет_третьего_без_второго", "when": "career_2_type == 'нет'", "then": [{"kind": "force", "param": "career_3_type", "value": "нет"}]},
    {"name": "нет_третьего_места_нет_лет", "when": "career_3_type == 'нет'", "then": [{"kind": "range", "param": "career_3_years", "max": 0.0}]},
    {"name": "есть_третье_место_есть_годы", "when": "career_3_type != 'нет'", "then": [{"kind": "range", "param": "career_3_years", "min": 1.0}]},

    {"name": "молодые_с_короткой_карьерой", "when": "age <= 34", "then": [
      {"kind": "range", "param": "career_1_years", "max": 4.0},
      {"kind": "weight", "param": "career_2_type", "value": "нет", "factor": 5.0},
      {"kind": "range", "param": "current_years", "max": 4.0}
    ]},
    {"name": "молодым_третьего_места_нет", "when": "age <= 40", "then": [
      {"kind": "weight", "param": "career_3_type", "value": "нет", "factor": 4.0}
    ]},
    {"name": "зрелые_с_длинной_карьерой", "when": "age >= 48", "then": [
      {"kind": "range", "param": "career_1_years", "min": 4.0},
      {"kind": "weight", "param": "career_2_type", "value": "нет", "factor": 0.2},
      {"kind": "range", "param": "current_years", "min": 3.0}
    ]},
    {"name": "старшим_третье_место", "when": "age >= 55", "then": [
      {"kind": "weight", "param": "career_3_type", "value": "нет", "factor": 0.3}
    ]},
    {"name": "старшим_длинные_этапы", "when": "age >= 55", "then": [
      {"kind": "range", "param": "career_1_years", "min": 7.0},
      {"kind": "range", "param": "current_years", "min": 6.0}
    ]},
    {"name": "старшим_длинные_этапы_2", "when": "age >= 55 and career_2_type != 'нет'", "then": [
      {"kind": "range", "param": "career_2_years", "min": 6.0}
    ]},
    {"name": "старшим_длинные_этапы_3", "when": "age >= 55 and career_3_type != 'нет'", "then": [
      {"kind": "range", "param": "career_3_years", "min": 5.0}
    ]},

    {"name": "стаж_к_должности", "when": "experience_years < 10", "then": [
      {"kind": "weight", "param": "current_position", "value": "заведующий отделением", "factor": 0.0},
      {"kind": "weight", "param": "current_position", "value": "главный врач", "factor": 0.0}
    ]},
    {"name": "стаж_к_категории", "when": "experience_years < 7", "then": [
      {"kind": "weight", "param": "qualification_category", "value": "высшая", "factor": 0.0}
    ]},
    {"name": "молодые_без_категории", "when": "experience_years < 3", "then": [
      {"kind": "force", "param": "qualification_category", "value": "без категории"}
    ]},
    {"name": "возраст_к_степени", "when": "age >= 52", "then": [
      {"kind": "weight", "param": "education_level", "value": "доктор медицинских наук", "factor": 3.0},
      {"kind": "weight", "param": "education_level", "value": "кандидат медицинских наук", "factor": 1.8}
    ]},
    {"name": "молодость_без_степени", "when": "age <= 34", "then": [
      {"kind": "weight", "param": "education_level", "value": "специалитет и ординатура", "factor": 3.0}
    ]},
    {"name": "степень_к_науке", "when": "in(education_level, 'кандидат медицинских наук', 'доктор медицинских наук')", "then": [
      {"kind": "weight", "param": "academic_activity", "value": "true", "factor": 4.0}
    ]},
    {"name": "наука_даёт_публикации", "when": "academic_activity", "then": [
      {"kind": "range", "param": "publications", "min": 2.0},
      {"kind": "weight", "param": "research_area", "value": "нет", "factor": 0.0},
      {"kind": "weight", "param": "conferences", "value": "true", "factor": 4.0}
    ]},
    {"name": "без_науки_без_публикаций", "when": "not academic_activity", "then": [
      {"kind": "range", "param": "publications", "max": 0.0},
      {"kind": "force", "param": "research_area", "value": "нет"}
    ]},
    {"name": "опытные_учат", "when": "experience_years >= 15", "then": [
      {"kind": "weight", "param": "teaches_residents", "value": "true", "factor": 2.5}
    ]},
    {"name": "молодые_не_учат", "when": "experience_years < 10", "then": [
      {"kind": "weight", "param": "teaches_residents", "value": "true", "factor": 0.0}
    ]},
    {"name": "психиатр_с_двойным_диагнозом", "when": "psychiatry_experience", "then": [
      {"kind": "weight", "param": "practice", "value": "двойной диагноз", "factor": 2.5}
    ]},
    {"name": "без_психиатрии_без_двойного", "when": "not psychiatry_experience", "then": [
      {"kind": "weight", "param": "practice", "value": "двойной диагноз", "factor": 0.0}
    ]},
    {"name": "психотерапевт_реже_детоксицирует", "when": "specialty == 'психотерапевт'", "then": [
      {"kind": "weight", "param": "detox_experience", "value": "true", "factor": 0.3}
    ]},
    {"name": "реаниматолог_детоксицирует", "when": "specialty == 'нарколог-реаниматолог'", "then": [
      {"kind": "force", "param": "detox_experience", "value": true}
    ]},
    {"name": "психотерапевт_без_фармакотерапии_чаще", "when": "specialty == 'психотерапевт'", "then": [
      {"kind": "weight", "param": "methods", "value": "фармакотерапия", "factor": 0.3},
      {"kind": "weight", "param": "methods", "value": "когнитивно-поведенческая терапия", "factor": 3.0}
    ]},
    {"name": "многодетность_к_подросткам", "when": "children_count >= 3", "then": [
      {"kind": "weight", "param": "patient_age_focus", "value": "подростки и молодёжь", "factor": 6.0},
      {"kind": "weight", "param": "practice", "value": "подростковая зависимость", "factor": 3.0}
    ]},
    {"name": "возраст_к_старшим_пациентам", "when": "age >= 55", "then": [
      {"kind": "weight", "param": "patient_age_focus", "value": "пациенты старшего возраста", "factor": 3.0}
    ]},
    {"name": "со_скорой_приходят_со_скорой", "when": "career_1_type == 'скорая помощь'", "then": [
      {"kind": "weight", "param": "why_addiction", "value": "увидел масштаб проблемы, работая на скорой", "factor": 6.0}
    ]},
    {"name": "без_скорой_без_этой_истории", "when": "career_1_type != 'скорая помощь'", "then": [
      {"kind": "weight", "param": "why_addiction", "value": "увидел масштаб проблемы, работая на скорой", "factor": 0.0}
    ]},
    {"name": "распределение_у_старших", "when": "graduation_year > 1994", "then": [
      {"kind": "weight", "param": "why_addiction", "value": "распределение после вуза", "factor": 0.0}
    ]},
    {"name": "зависимость_в_семье_к_истории", "when": "life_turn == 'зависимость в семье'", "then": [
      {"kind": "weight", "param": "why_addiction", "value": "зависимость у близкого человека", "factor": 6.0}
    ]},
    {"name": "семейная_практика_к_семье", "when": "family_counseling", "then": [
      {"kind": "weight", "param": "memorable_case", "value": "семья, которая не отступилась от человека", "factor": 2.0},
      {"kind": "weight", "param": "quote_theme", "value": "роль семьи", "factor": 2.0}
    ]},
    {"name": "подростки_к_случаю", "when": "patient_age_focus == 'подростки и молодёжь'", "then": [
      {"kind": "weight", "param": "memorable_case", "value": "подросток, которого привели родители", "factor": 4.0}
    ]},
    {"name": "награды_у_опытных", "when": "experience_years < 12", "then": [
      {"kind": "weight", "param": "awards", "value": "нет", "factor": 4.0}
    ]}
  ]
}
