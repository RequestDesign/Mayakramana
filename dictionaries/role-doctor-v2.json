{
  "name": "role-doctor-v2",
  "version": 2,
  "description": "Черновик на согласование. Врач с карьерой по этапам: где и сколько работал, какая ординатура, какая категория, почему пришёл в наркологию. Стаж здесь не случайное число, а сумма этапов карьеры; число мест работы и опыт в госклинике и психиатрии тоже вычисляются из этапов — так они не могут противоречить друг другу.",
  "extends": ["human-core-v2.json", "human-visual-v2.json"],
  "params": [
    {
      "key": "education_level",
      "title": "Уровень образования",
      "group": "образование",
      "identity": true,
      "domain": {"kind": "enum", "variants": [
        {"value": "специалитет и ординатура", "weight": 46},
        {"value": "ординатура и профпереподготовка", "weight": 24},
        {"value": "кандидат медицинских наук", "weight": 22},
        {"value": "доктор медицинских наук", "weight": 8}
      ]}
    },
    {
      "key": "alma_mater",
      "title": "Где учился",
      "group": "образование",
      "identity": true,
      "note": "Описательно, без названий реальных вузов — приписывать реальному учреждению несуществующих выпускников нельзя.",
      "domain": {"kind": "enum", "variants": [
        {"value": "столичный медицинский университет", "weight": 22},
        {"value": "медицинский университет в Санкт-Петербурге", "weight": 12},
        {"value": "медицинский университет в Поволжье", "weight": 16},
        {"value": "медицинский университет на Урале", "weight": 14},
        {"value": "медицинский университет в Сибири", "weight": 14},
        {"value": "медицинский университет на юге России", "weight": 14},
        {"value": "медицинский университет на Дальнем Востоке", "weight": 8}
      ]}
    },
    {
      "key": "graduation_age",
      "title": "Возраст окончания вуза",
      "usage": "store_only",
      "domain": {"kind": "int", "min": 23, "max": 31, "weights": [30, 28, 16, 10, 6, 4, 3, 2, 1]}
    },
    {
      "key": "graduation_year",
      "title": "Год окончания вуза",
      "group": "образование",
      "note": "Вычисляется из возраста — не может разойтись с ним.",
      "domain": {"kind": "computed", "expr": "2026 - age + graduation_age"}
