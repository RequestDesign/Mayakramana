      "group": "опыт",
      "note": "Следует из ординатуры и мест работы, а не выбирается отдельно.",
      "domain": {"kind": "computed", "expr": "in(residency, 'психиатрия-наркология', 'психиатрия') or career_1_type == 'психиатрическая больница' or career_2_type == 'психиатрическая больница' or career_3_type == 'психиатрическая больница'"}
    },
