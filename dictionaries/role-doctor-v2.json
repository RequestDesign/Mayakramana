    {
      "key": "residency",
      "title": "Ординатура",
      "group": "образование",
      "domain": {"kind": "enum", "variants": [
        {"value": "психиатрия-наркология", "weight": 45},
        {"value": "психиатрия", "weight": 32},
        {"value": "неврология", "weight": 10},
        {"value": "анестезиология-реаниматология", "weight": 13}
      ]}
    },
    {
      "key": "specialty",
      "title": "Специальность",
      "group": "опыт",
      "identity": true,
      "mention": "required",
      "note": "Следует из ординатуры: психотерапевтом или наркологом без психиатрической базы в России не стать.",
      "domain": {"kind": "enum", "variants": [
        {"value": "психиатр-нарколог", "weight": 46},
        {"value": "психиатр", "weight": 22},
        {"value": "психотерапевт", "weight": 18},
        {"value": "нарколог-реаниматолог", "weight": 8},
        {"value": "невролог с наркологической практикой", "weight": 6}
      ]}
    },
    {
      "key": "second_education",
      "title": "Второе образование",
      "group": "образование",
      "domain": {"kind": "bool", "p_true": 0.2}
    },

    {
      "key": "career_1_type",
      "title": "Первое место работы",
      "group": "карьера",
      "identity": true,
      "note": "Тип учреждения, без названия: конкретное название реальной больницы приписало бы ей несуществующего сотрудника.",
      "domain": {"kind": "enum", "variants": [
        {"value": "районная больница", "weight": 18},
        {"value": "городской наркологический диспансер", "weight": 22},
        {"value": "областной наркологический диспансер", "weight": 16},
