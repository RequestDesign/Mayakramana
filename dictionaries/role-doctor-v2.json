        {"value": "военный госпиталь", "weight": 5},
        {"value": "частная клиника", "weight": 11}
      ]}
    },
    {
      "key": "career_1_years",
      "title": "Лет на первом месте",
      "group": "карьера",
      "domain": {"kind": "int", "min": 1, "max": 12}
    },
    {
      "key": "career_2_type",
      "title": "Второе место работы",
      "group": "карьера",
      "domain": {"kind": "enum", "variants": [
        {"value": "нет", "weight": 25},
        {"value": "районная больница", "weight": 8},
        {"value": "городской наркологический диспансер", "weight": 16},
        {"value": "областной наркологический диспансер", "weight": 14},
        {"value": "психиатрическая больница", "weight": 12},
        {"value": "частная клиника", "weight": 14},
        {"value": "реабилитационный центр", "weight": 11}
      ]}
    },
    {
      "key": "career_2_years",
      "title": "Лет на втором месте",
      "group": "карьера",
      "domain": {"kind": "int", "min": 0, "max": 12}
    },
    {
      "key": "career_3_type",
