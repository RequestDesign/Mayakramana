      "group": "карьера",
      "domain": {"kind": "enum", "variants": [
        {"value": "нет", "weight": 50},
        {"value": "областной наркологический диспансер", "weight": 10},
        {"value": "психиатрическая больница", "weight": 8},
        {"value": "частная клиника", "weight": 16},
        {"value": "реабилитационный центр", "weight": 16}
