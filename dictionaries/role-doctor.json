{
  "name": "role-doctor",
  "version": 1,
  "description": "Врач-психиатр, нарколог. Наследует общечеловеческие параметры и внешность, добавляет образование, опыт и практику. Первая роль, на которой отлаживается вся механика.",
  "extends": ["human-core.json", "human-visual.json"],
  "params": [
    {
      "key": "education_level",
      "title": "Уровень образования",
      "group": "образование",
      "identity": true,
      "domain": {
        "kind": "enum",
        "variants": [
          {"value": "специалитет и ординатура", "weight": 46},
          {"value": "ординатура и профпереподготовка", "weight": 24},
          {"value": "кандидат медицинских наук", "weight": 22},
          {"value": "доктор медицинских наук", "weight": 8}
        ]
      }
    },
    {
      "key": "alma_mater",
      "title": "Где получено образование",
      "group": "образование",
      "identity": true,
      "note": "Намеренно описательные формулировки, без названий конкретных вузов: приписывать реальному учреждению несуществующих выпускников — отдельный риск. Заменить на список названий можно здесь же, если решение будет другим.",
      "domain": {
        "kind": "enum",
        "variants": [
          {"value": "столичный медицинский университет", "weight": 22},
          {"value": "медицинский университет в Санкт-Петербурге", "weight": 12},
          {"value": "медицинский университет в Поволжье", "weight": 16},
          {"value": "медицинский университет на Урале", "weight": 14},
          {"value": "медицинский университет в Сибири", "weight": 14},
          {"value": "медицинский университет на юге России", "weight": 14},
          {"value": "медицинский университет на Дальнем Востоке", "weight": 8}
        ]
      }
    },
    {
      "key": "second_education",
      "title": "Второе образование",
      "group": "образование",
      "domain": {"kind": "bool", "p_true": 0.22}
    },
    {
      "key": "specialty",
      "title": "Специальность",
      "group": "опыт",
      "identity": true,
      "mention": "required",
      "domain": {
        "kind": "enum",
        "variants": [
          {"value": "психиатр-нарколог", "weight": 46},
          {"value": "психиатр", "weight": 22},
          {"value": "психотерапевт", "weight": 18},
          {"value": "нарколог-реаниматолог", "weight": 8},
          {"value": "невролог с наркологической практикой", "weight": 6}
        ]
      }
    },
    {
      "key": "experience_years",
      "title": "Стаж, лет",
      "group": "опыт",
      "identity": true,
      "note": "Жёсткое правило ограничивает стаж возрастом, но без весов середина диапазона недобирала бы: равномерность давала бы слишком много ветеранов с сорокалетним стажем.",
      "domain": {
        "kind": "int", "min": 2, "max": 40,
        "weights": [3, 4, 5, 6, 7, 8, 8, 8, 8, 7, 7, 7, 6, 6, 6, 5, 5, 5, 4, 4, 4, 3.5, 3.5, 3, 3, 3, 2.5, 2.5, 2, 2, 2, 1.5, 1.5, 1.2, 1.2, 1, 1, 0.8, 0.8]
      }
    },
    {
      "key": "workplaces_count",
      "title": "Мест работы за карьеру",
      "group": "опыт",
      "mention": "background",
      "directive": "этапов карьеры описать (число в текст не переносить)",
      "note": "Определяет, сколько этапов карьеры описать, а не сообщается числом.",
      "domain": {"kind": "int", "min": 1, "max": 6}
    },
    {
      "key": "qualification_courses",
      "title": "Повышений квалификации",
      "group": "образование",
      "mention": "background",
      "directive": "насколько человек тяготеет к учёбе, 0-7 (число в текст не переносить)",
      "note": "Объявлен после стажа намеренно: корреляция опирается на уже сэмплированный стаж. Счётчик не называется вслух — «прошёл шесть повышений квалификации» звучит как выписка из личного дела.",
      "domain": {"kind": "int", "min": 0, "max": 7}
    },
    {
      "key": "state_clinic_background",
      "title": "Опыт в государственной клинике",
      "group": "опыт",
      "domain": {"kind": "bool", "p_true": 0.62}
    },
    {
      "key": "psychiatry_experience",
      "title": "Опыт в психиатрии",
      "group": "опыт",
      "domain": {"kind": "bool", "p_true": 0.55}
    },
    {
      "key": "detox_experience",
      "title": "Опыт детоксикации и купирования",
      "group": "опыт",
      "domain": {"kind": "bool", "p_true": 0.7}
    },
    {
      "key": "practice",
      "title": "С кем работал",
      "group": "практика",
      "note": "Множественный выбор, а не одно поле «специализация»: реальная практика почти всегда смешанная.",
      "domain": {
        "kind": "multi_enum",
        "min_pick": 1,
        "max_pick": 4,
        "variants": [
          {"value": "наркозависимые", "weight": 30},
          {"value": "алкогольная зависимость", "weight": 30},
          {"value": "игровая зависимость", "weight": 10},
          {"value": "созависимые родственники", "weight": 14},
          {"value": "двойной диагноз", "weight": 12},
          {"value": "подростковая зависимость", "weight": 8}
        ]
      }
    },
    {
      "key": "family_counseling",
      "title": "Консультирование родственников",
      "group": "практика",
      "domain": {"kind": "bool", "p_true": 0.5}
    },
    {
      "key": "academic_activity",
      "title": "Научная или преподавательская работа",
      "group": "практика",
      "domain": {"kind": "bool", "p_true": 0.25}
    },
    {
      "key": "publications",
      "title": "Публикаций",
      "group": "практика",
      "mention": "background",
      "directive": "насколько заметен в профессиональной среде, 0-25 (число в текст не переносить)",
      "note": "Объявлен после academic_activity намеренно: корреляция читает уже сэмплированное значение. Распределение с тяжёлым левым краем: у большинства публикаций нет вовсе.",
      "domain": {
        "kind": "int", "min": 0, "max": 25,
        "weights": [40, 14, 12, 10, 8, 6, 5, 4, 3, 3, 2, 2, 2, 1.5, 1.5, 1, 1, 1, 1, 1, 0.8, 0.8, 0.6, 0.6, 0.5, 0.5]
      }
    },
    {
      "key": "patient_age_focus",
      "title": "Возрастной фокус пациентов",
      "group": "практика",
      "identity": true,
      "mention": "background",
      "directive": "о каких пациентах писать (показать через описание работы, не называть категорией)",
      "note": "Должен читаться из описания практики, а не подаваться строкой «возрастной фокус — подростки».",
      "domain": {
        "kind": "enum",
        "variants": [
          {"value": "взрослые", "weight": 60},
          {"value": "смешанный", "weight": 22},
          {"value": "подростки и молодёжь", "weight": 10},
          {"value": "пациенты старшего возраста", "weight": 8}
        ]
      }
    },
    {
      "key": "approach",
      "title": "Подход к работе",
      "group": "практика",
      "domain": {
        "kind": "enum",
        "variants": [
          {"value": "медикаментозная стабилизация как основа", "weight": 24},
          {"value": "сочетание фармакологии и психотерапии", "weight": 32},
          {"value": "упор на мотивацию и работу с отрицанием", "weight": 20},
          {"value": "работа с семейной системой", "weight": 14},
          {"value": "длительное сопровождение после выписки", "weight": 10}
        ]
      }
    },
    {
      "key": "full_name",
      "title": "ФИО",
      "group": "базовые",
      "identity": true,
      "mention": "required",
      "note": "Заполняется из справочника имён после сэмплирования: имя зависит от пола и года рождения, отчество — от имени отца поколением раньше. Модели выдумывать имя запрещено.",
      "domain": {"kind": "derived"}
    },
    {
      "key": "biography",
      "title": "Биография",
      "group": "текст",
      "domain": {"kind": "derived"}
    },
    {
      "key": "professional_path",
      "title": "Профессиональный путь",
      "group": "текст",
      "domain": {"kind": "derived"}
    },
    {
      "key": "quote",
      "title": "Цитата",
      "group": "текст",
      "domain": {"kind": "derived"}
    }
  ],
  "hard": [
    {
      "name": "стаж_не_больше_возможного",
      "expr": "experience_years <= age - 24",
      "message": "стаж превышает возможный: медицинское образование занимает не меньше шести лет"
    },
    {
      "name": "докторская_не_рано",
      "expr": "education_level != 'доктор медицинских наук' or age >= 45",
      "message": "докторская степень раньше 45 лет в этой популяции не моделируется"
    },
    {
      "name": "кандидатская_не_рано",
      "expr": "education_level != 'кандидат медицинских наук' or age >= 32",
      "message": "кандидатская степень раньше 32 лет в этой популяции не моделируется"
    },
    {
      "name": "публикации_только_у_научных",
      "expr": "publications == 0 or academic_activity",
      "message": "публикации без научной или преподавательской работы"
    },
    {
      "name": "психиатр_имеет_психиатрический_опыт",
      "expr": "not in(specialty, 'психиатр', 'психиатр-нарколог') or psychiatry_experience",
      "message": "специальность психиатра при отсутствии психиатрического опыта"
    },
    {
      "name": "реаниматолог_имеет_опыт_детоксикации",
      "expr": "specialty != 'нарколог-реаниматолог' or detox_experience",
      "message": "нарколог-реаниматолог без опыта детоксикации"
    },
    {
      "name": "двойной_диагноз_требует_психиатрии",
      "expr": "not has(practice, 'двойной диагноз') or psychiatry_experience",
      "message": "работа с двойным диагнозом без психиатрического опыта"
    },
    {
      "name": "подростки_требуют_фокуса",
      "expr": "not has(practice, 'подростковая зависимость') or patient_age_focus != 'пациенты старшего возраста'",
      "message": "подростковая практика при фокусе на пациентах старшего возраста"
    },
    {
      "name": "мест_работы_соразмерно_стажу",
      "expr": "workplaces_count <= 1 + experience_years / 4",
      "message": "слишком частая смена мест работы для такого стажа: в среднем меньше четырёх лет на месте"
    }
  ],
  "soft": [
    {
      "name": "многодетность_к_подростковой_практике",
      "when": "children_count >= 3",
      "then": [
        {"kind": "weight", "param": "patient_age_focus", "value": "подростки и молодёжь", "factor": 6.0},
        {"kind": "weight", "param": "practice", "value": "подростковая зависимость", "factor": 3.0}
      ]
    },
    {
      "name": "возраст_к_старшим_пациентам",
      "when": "age >= 55",
      "then": [
        {"kind": "weight", "param": "patient_age_focus", "value": "пациенты старшего возраста", "factor": 3.0},
        {"kind": "weight", "param": "patient_age_focus", "value": "подростки и молодёжь", "factor": 0.3}
      ]
    },
    {
      "name": "возраст_к_степени",
      "when": "age >= 52",
      "then": [
        {"kind": "weight", "param": "education_level", "value": "доктор медицинских наук", "factor": 3.0},
        {"kind": "weight", "param": "education_level", "value": "кандидат медицинских наук", "factor": 1.8}
      ]
    },
    {
      "name": "молодость_без_степени",
      "when": "age <= 34",
      "then": [
        {"kind": "weight", "param": "education_level", "value": "специалитет и ординатура", "factor": 3.0}
      ]
    },
    {
      "name": "стаж_растёт_с_возрастом_после_50",
      "when": "age >= 52",
      "then": [{"kind": "range", "param": "experience_years", "min": 11.0}]
    },
    {
      "name": "стаж_растёт_с_возрастом_после_42",
      "when": "age >= 42",
      "then": [{"kind": "range", "param": "experience_years", "min": 6.0}]
    },
    {
      "name": "стаж_растёт_с_возрастом_после_34",
      "when": "age >= 34",
      "then": [{"kind": "range", "param": "experience_years", "min": 3.0}]
    },
    {
      "name": "у_молодых_стаж_небольшой",
      "when": "age <= 33",
      "then": [{"kind": "range", "param": "experience_years", "max": 8.0}]
    },
    {
      "name": "опыт_к_числу_мест",
      "when": "experience_years >= 20",
      "then": [
        {"kind": "range", "param": "workplaces_count", "min": 2.0}
      ]
    },
    {
      "name": "малый_стаж_одно_место",
      "when": "experience_years <= 5",
      "then": [
        {"kind": "range", "param": "workplaces_count", "max": 2.0}
      ]
    },
    {
      "name": "наука_даёт_публикации",
      "when": "academic_activity",
      "then": [
        {"kind": "range", "param": "publications", "min": 2.0}
      ]
    },
    {
      "name": "без_науки_нет_публикаций",
      "when": "not academic_activity",
      "then": [
        {"kind": "range", "param": "publications", "max": 0.0}
      ]
    },
    {
      "name": "психиатр_чаще_с_двойным_диагнозом",
      "when": "in(specialty, 'психиатр', 'психиатр-нарколог')",
      "then": [
        {"kind": "weight", "param": "practice", "value": "двойной диагноз", "factor": 2.5}
      ]
    },
    {
      "name": "психотерапевт_реже_детоксицирует",
      "when": "specialty == 'психотерапевт'",
      "then": [
        {"kind": "weight", "param": "detox_experience", "value": "true", "factor": 0.3}
      ]
    },
    {
      "name": "стаж_к_повышениям_квалификации",
      "when": "experience_years >= 15",
      "then": [
        {"kind": "range", "param": "qualification_courses", "min": 2.0}
      ]
    }
  ]
}
