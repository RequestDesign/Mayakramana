# --- Nexorium ---------------------------------------------------------------
# Изнутри Docker используйте внутренний адрес: минует Caddy, TLS и внешний канал.
NEXORIUM_BASE=http://nexorium:8200/api/v1
# Снаружи (для probe с локальной машины):
# NEXORIUM_BASE=https://nexorium.trger.ru/api/v1

NEXORIUM_SPACE=
# Для создания коллекций и полей нужен ключ с правами admin — с write будет 403.
NEXORIUM_KEY=

# --- Оперативное состояние ---------------------------------------------------
# Обязательно на volume: здесь живёт возобновляемость сессий.
SYNTHFORGE_DB=/data/synthforge.db

# --- Сервер ------------------------------------------------------------------
BIND_ADDR=0.0.0.0:8080
RUST_LOG=info,synthforge=debug
TZ=Europe/Moscow

# --- Провайдеры LLM (Ф1+) ----------------------------------------------------
XAI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
